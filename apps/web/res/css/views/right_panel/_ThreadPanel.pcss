.mx_ThreadPanel {
    height: 100px;
    overflow: visible;

    .mx_ThreadPanelHeader {
        height: 64px;
        display: flex;
        box-sizing: border-box;
        /* No vertical padding: the tabs need the full 64px height to avoid overflowing */
        padding: 0 var(--cpd-space-4x);
        align-items: center;
        border-bottom: 1px solid var(--cpd-color-gray-400);

        .mx_ThreadPanel_tabs {
            /* Align tabs to bottom edge of header so the underline sits on the border */
            align-self: flex-end;
            /* Override NavBar's default block margin and bottom border; the header draws its own border */
            margin: 0;
            border-block-end: none;
        }

        /* Mark-all-read action, pushed to the end of the header after the tabs */
        .mx_ThreadPanel_markAllRead {
            align-self: center;
            margin-inline-start: auto;
        }
    }

    /* Wrapper around the thread list; lets the timeline shrink and scroll inside the card */
    .mx_ThreadPanel_tabPanel {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .mx_AutoHideScrollbar,
    .mx_RoomView_messagePanelSpinner {
        background-color: $background;
        border-radius: 8px;
        padding-inline-end: 0;
        overflow-y: scroll; /* set gap between the thread tile and the right border */
        height: 100%;
    }

    /* For style rules of EventTile in a thread, see _EventTile.pcss */
    &.mx_ThreadView {
        max-height: 100%;

        .mx_ThreadView_timelinePanelWrapper {
            position: relative;
            min-height: 0; /* don't displace the composer */
            flex-grow: 1;

            .mx_FileDropTarget {
                border-radius: 8px;
            }
        }

        .mx_MessageComposer_sendMessage {
            margin-right: 0;
        }

        /* Make use of the space above the composer buttons too */
        .mx_Autocomplete {
            width: calc(100% + 140px);
        }
        &.mx_ThreadView_narrow .mx_Autocomplete {
            width: calc(100% + 108px);
        }
    }

    .mx_RoomView_messagePanel {
        &.mx_RoomView_messageListWrapper {
            position: initial;
        }

        .mx_RoomView_messageListWrapper {
            width: calc(100% + 6px); /* 8px - 2px */
        }

        .mx_RoomView_empty {
            display: contents;
        }
    }

    .mx_RoomView_MessageList {
        padding-inline-start: var(--cpd-space-2x);
        padding-inline-end: var(--cpd-space-2x);
        content-visibility: visible;
    }

    .mx_GenericEventListSummary {
        /* Account for scrollbar when hovering */
        padding-top: 0;

        .mx_TimelineSeparator {
            display: none;
        }
    }

    .mx_MessageComposer {
        background-color: $background;
        border-radius: 8px;
        margin-top: 8px;
        padding: 0 8px;
        box-sizing: border-box;
    }

    .mx_BaseCard_footer {
        text-align: left;
        font-size: $font-12px;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        position: relative;
        top: 2px;
        padding-right: 8px;

        .mx_AccessibleButton_kind_link_inline {
            color: $secondary-content;
        }
    }
}
